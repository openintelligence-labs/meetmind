# ─── architecture docs (uncooked — kept local until polished) ───
docs/

# ─── local tooling config ───
.claude/
.claude/settings.local.json

# ─── uncooked dev docs ───
CLAUDE.md

# ─── Python ───
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
wheels/
.venv/
venv/
env/

# ─── Python tooling caches ───
.pytest_cache/
.ruff_cache/
.mypy_cache/
.import_linter_cache/
.coverage
.coverage.*
htmlcov/

# ─── Swift sidecars (684 MB of build outputs) ───
sidecars/**/.build/

# ─── Tauri / Rust (mirrored from tauri/src-tauri/.gitignore) ───
target/
gen/
Cargo.lock

# ─── frontend (Tauri UI may grow these) ───
node_modules/
.next/
.cache/
*.tsbuildinfo

# ─── Generated test fixtures (recreated each run) ───
tests/fixtures/_mock_*_launcher.sh

# ─── User data — NEVER commit recordings or local archives ───
# Triggered if anyone sets MEETMIND_HOME to a path in-repo.
data/
audio/
meetmind/data/
meetmind/audio/
*.wav
*.flac
*.m4a
*.mp3
*.sqlite
*.db
*.db-wal
*.db-shm
*.duckdb

# ─── Secrets / credentials (defensive) ───
.env
.env.*
secrets.*
*.pem
*.key
*.p12
*.crt
id_rsa*
# matches the bearer-token file at $MEETMIND_HOME/token if MEETMIND_HOME is in-repo
token

# ─── Editor / OS junk ───
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
*.orig
.AppleDouble
.LSOverride

# ─── design references (kept locally, not tracked) ───
mockups/

# ─── Logs ───
*.log
